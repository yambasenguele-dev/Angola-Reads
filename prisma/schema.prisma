// ============================================================
// Schema AngolaReads - Sistema de Vendas de Ebooks Digitais
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Categorias de Ebooks
// ============================================================
model Categoria {
  id          String    @id @default(cuid())
  nome        String    @unique
  descricao   String?
  slug        String    @unique
  ativa       Boolean   @default(true)
  ordem       Int       @default(0)
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  produtos    Produto[]

  @@index([slug])
  @@index([ativa])
  @@map("categorias")
}

// ============================================================
// Produtos (Ebooks, Bundles, Cursos Limitados)
// ============================================================
model Produto {
  id              String    @id @default(cuid())
  titulo          String
   descricao       String
  descricaoCurta  String?
  capaUrl         String?
  tipoProduto     String    @default("ebook") // ebook, bundle, curso_limitado
  formatoPdf      String?   // caminho do ficheiro PDF
  formatoEpub     String?   // caminho do ficheiro EPUB
  precoNormal     Float     // preço em AOA
  precoPromocional Float?
  precoUsd        Float?
  precoEur        Float?
  categoriaId     String
  ativo           Boolean   @default(true)
  destaque        Boolean   @default(false)
  comissaoAfiliado Int      @default(20) // 20, 30 ou 40
  estoqueIlimitado Boolean  @default(true)
  estoqueMaximo   Int?
  vendasCount     Int       @default(0)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  categoria       Categoria  @relation(fields: [categoriaId], references: [id])
  itensPedido     ItemPedido[]
  afiliados       ComissaoAfiliado[]

  @@index([titulo])
  @@index([categoriaId])
  @@index([ativo])
  @@index([destaque])
  @@index([tipoProduto])
  @@map("produtos")
}

// ============================================================
// Perfis de Utilizadores
// ============================================================
model Perfil {
  id            String    @id @default(cuid())
  email         String    @unique
  nomeCompleto  String
  senhaHash     String
  telefone      String?
  isAdmin       Boolean   @default(false)
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  pedidos       Pedido[]
  downloads     Download[]
  afiliado      Afiliado?

  @@index([email])
  @@map("perfis")
}

// ============================================================
// Pedidos
// ============================================================
model Pedido {
  id              String    @id @default(cuid())
  referencia      String    @unique // referência única do pedido
  perfilId        String
  estado          String    @default("pendente") // pendente, pago, rejeitado, cancelado
  metodoPagamento String    // transferencia_bancaria, airtm, paypal
  subtotal        Float
  moeda           String    @default("AOA")
  afiliadoId      String?
  observacoes     String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  perfil          Perfil    @relation(fields: [perfilId], references: [id])
  itens           ItemPedido[]
  comprovativo    Comprovativo?
  afiliado        Afiliado? @relation("VendasAfiliado", fields: [afiliadoId], references: [id])

  @@index([perfilId])
  @@index([referencia])
  @@index([estado])
  @@index([afiliadoId])
  @@map("pedidos")
}

// ============================================================
// Itens do Pedido
// ============================================================
model ItemPedido {
  id         String  @id @default(cuid())
  pedidoId   String
  produtoId  String
  titulo     String  // denormalizado para consulta rápida
  preco      Float   // preço no momento da compra
  formato    String  @default("pdf")

  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}

// ============================================================
// Comprovativos de Pagamento
// ============================================================
model Comprovativo {
  id          String    @id @default(cuid())
  pedidoId    String    @unique
  ficheiroUrl String    // caminho do ficheiro enviado
  estado      String    @default("pendente") // pendente, aprovado, rejeitado
  observacoes String?
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  pedido      Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@map("comprovativos")
}

// ============================================================
// Downloads (registos de download liberados)
// ============================================================
model Download {
  id          String   @id @default(cuid())
  perfilId    String
  produtoId   String
  pedidoId    String
  formato     String   // pdf ou epub
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  perfil      Perfil   @relation(fields: [perfilId], references: [id])

  @@index([perfilId])
  @@index([produtoId])
  @@index([pedidoId])
  @@map("downloads")
}

// ============================================================
// Afiliados
// ============================================================
model Afiliado {
  id          String    @id @default(cuid())
  perfilId    String    @unique
  codigoRef   String    @unique // código de referência único
  saldo       Float     @default(0) // saldo disponível para levantamento
  totalGanho  Float     @default(0) // total ganho histórico
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  perfil      Perfil    @relation(fields: [perfilId], references: [id])
  comissoes   ComissaoAfiliado[]
  vendas      Pedido[]  @relation("VendasAfiliado")

  @@index([codigoRef])
  @@index([perfilId])
  @@map("afiliados")
}

// ============================================================
// Comissões de Afiliados
// ============================================================
model ComissaoAfiliado {
  id          String    @id @default(cuid())
  afiliadoId  String
  pedidoId    String
  produtoId   String
  valor       Float
  percentagem Int
  estado      String    @default("pendente") // pendente, paga
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  afiliado    Afiliado  @relation(fields: [afiliadoId], references: [id])
  produto     Produto   @relation(fields: [produtoId], references: [id])

  @@index([afiliadoId])
  @@index([pedidoId])
  @@index([estado])
  @@map("comissoes_afiliado")
}

// ============================================================
// Configurações do Sistema
// ============================================================
model Configuracao {
  id    String @id @default(cuid())
  chave String @unique
  valor String

  @@map("configuracoes")
}
