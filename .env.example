# ============================================================
# AngolaReads - Variáveis de Ambiente (Supabase)
# ============================================================
# Copia este ficheiro para ".env.local" e preenche com os valores
# do teu projeto Supabase (Project Settings > API).

# URL do projeto Supabase (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" (Project Settings > API > Project API keys)
# Segura para expor no browser — o acesso aos dados é controlado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" (Project Settings > API > Project API keys)
# NUNCA expor no browser. Usada apenas no servidor para gerar URLs
# assinadas de download e operações administrativas internas.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Emails transacionais (Resend) — OPCIONAL
# ============================================================
# Sem isto configurado, a aplicação funciona normalmente — os emails
# de "compra recebida", "pagamento aprovado", "saque aprovado/rejeitado"
# ficam apenas registados no log do servidor, sem serem enviados.
#
# Para ativar o envio real:
#   1. Cria conta em https://resend.com
#   2. Verifica o teu domínio de envio (Settings > Domains), ou usa
#      temporariamente "onboarding@resend.dev" enquanto testas
#   3. Gera uma API key em https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_REMETENTE="AngolaReads <naoresponder@teudominio.com>"

# URL pública do site (usada nos links dos emails)
NEXT_PUBLIC_URL_SITE=http://localhost:3000
